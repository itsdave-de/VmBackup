# /root/naubackup/.secrets  -  chmod 600, owner root
# key=value, no quotes. Read by runBackup.sh (lukspass) and VmBackup.py (mailuser, mailpass, api_token).
lukspass=passphrase-of-the-luks-backup-disks
mailuser=backup-sender@example.com
mailpass=smtp-password
api_token=bearer-token-of-the-itsdave-backup-api
